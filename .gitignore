# 打包产物（用 build_exe.bat 生成，不纳入仓库）
dist/
build/
*.spec

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时数据（配置里含访问码/token，绝不能提交）
data/
config.json
*.log
logs/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 分享包（不进 GitHub）
*.zip

# 开发文档只放本地，不进仓库
docs/DEVELOPMENT.md
docs/FEATURES.md
